TRAJECTORY_MODE = 2

TRAJECTORY_GRD = true
TRAJECTORY_LCH = true

--[[----------------------------------------------------------------------------------------------------
	Utilities
------------------------------------------------------------------------------------------------------]]
function cam_xform()
	local pos = device().cam_pos
	local dir = device().cam_dir
	return matrix():setHPB(dir:getH(),dir:getP(),0):translate_over(pos)
end

function get_grenade_ammo(section)
	local str = ini_sys:r_string_ex(section,"grenade_class")
	return str and str_explode(str,",")
end

function get_ammo_name(wpn)
	local sec = wpn:section()
	local ammo_type = wpn:get_ammo_type()
	local ammo_list = (IsLauncher(wpn) and utils_item.get_ammo(sec,wpn:id())) or get_grenade_ammo(sec)
	return ammo_type and ammo_list and ammo_list[ammo_type + 1]
end

function get_launch_speed(wpn)
	do
		local ammo_name = get_ammo_name(wpn)
		local speed = ammo_name and SYS_GetParam(2,ammo_name,"ammo_grenade_vel")
		if (speed) then
			return speed
		end
	end
	do
		local speed = SYS_GetParam(2,wpn:section(),"grenade_vel")
		if (speed) then
			return speed
		end
	end
	do
		local speed = SYS_GetParam(2,wpn:section(),"launch_speed")
		if (speed) then
			return speed
		end
	end
end

function vector_valid(vec)
	if (vec and (vec.x == vec.x) and (vec.y == vec.y) and (vec.z == vec.z)) then
		return true
	end
	return false
end

GRENADE_CLASSES = {
	[clsid.wpn_grenade_f1]		= true,
	[clsid.wpn_grenade_f1_s]	= true,
	[clsid.wpn_grenade_rgd5]	= true,
	[clsid.wpn_grenade_rgd5_s]	= true,
}
LAUNCHER_CLASSES = {
	[clsid.wpn_rg6_s]			= true,
	[clsid.wpn_rg6]				= true,
}

function WeaponGrenade(wpn)
	return GRENADE_CLASSES[wpn:clsid()] or false
end

function WeaponLauncher(wpn)
	return LAUNCHER_CLASSES[wpn:clsid()] or false
end

--[[----------------------------------------------------------------------------------------------------
	Point
------------------------------------------------------------------------------------------------------]]
class "CParticle"
function CParticle:__init(str)
	self.particle = particles_object(str)
	self.position = vector()
end

function CParticle:Update(pos)
	self.position:set(pos)
	self.particle:set_position(self.position)
end

function CParticle:Show(state)
	if (state) then
		if (self.particle:playing() ~= true) then
			self.particle:play()
		end
	else
		if (self.particle:playing() == true) then
			self.particle:stop()
		end
	end
end

--[[----------------------------------------------------------------------------------------------------
	HUD
------------------------------------------------------------------------------------------------------]]
HUD = nil

function hud_active()
	if (HUD == nil) then
		HUD = CGrenadeTrajectory()
		get_hud():AddDialogToRender(HUD)
	end
end

function hud_remove()
	if (HUD) then
		get_hud():RemoveDialogToRender(HUD)
		HUD = nil
	end
end

function hud_update()
	if (HUD) then
		HUD:Update(true)
	end
end

class "CGrenadeTrajectory" (CUIScriptWnd)

function CGrenadeTrajectory:__init() super()
	self.st = nil
	
	self.launcher_hide_states = {
		[CWeapon.eReload]				= true,
		[CWeapon.eMisfire]				= true,
		[CWeapon.eSwitch]				= true,
		[CWeapon.eSwitchMode]			= true,
	}
	
	self.index_min = 2
	self.index_max = 60
	
	self.particles_sec = [[_samples_particles_\grenade_throw_trajectory]]
	self.indicator_sec = [[_samples_particles_\grenade_throw_indicator]]
	
	self.particles = {}
	for idx=self.index_min,self.index_max do
		self.particles[idx] = CParticle(self.particles_sec)
	end
	self.indicator = CParticle(self.indicator_sec)
end

function CGrenadeTrajectory:__finalize()
end

function CGrenadeTrajectory:Update()
	CUIScriptWnd.Update(self)
	
	local wpn = db.actor:active_item()
	if not (self:WeaponValidate(wpn)) then
		return self:Close()
	end
	
	if (level.get_active_cam() ~= 0) then
		return self:Hide()
	end
	
	if not (self.st and (self.st.oid == wpn:id())) then
		self:WeaponLoadData(wpn)
	end
	
	if not (self:IsModeShow(wpn)) then
		return self:Hide()
	end
	
	if (self.st.init_time > time_global()) then
		return self:Hide()
	end
	
	if (self.st.is_grenade ~= true) then
		if (axr_main.weapon_is_zoomed or self.launcher_hide_states[wpn:get_state()]) then
			return self:Hide()
		end
	end
	
	local pos = self:GetFirePosition(wpn)
	local vel = self:GetFireVelocity(wpn)
	if not (vector_valid(pos) and vector_valid(vel)) then
		return self:Hide()
	end
	
	self.indicator_idx = nil
	
	-- Calculate.
	local pre = 0
	local ray = ray_pick(vector():set(0,0,0),vector():set(0,0,1),0,2,db.actor)
	for idx=self.index_min,self.index_max do
		self.particles[idx]:Update(self:TrajectoryPosition(pos,vel,idx * 0.05))
		
		if (self.indicator_idx == nil) and (self.particles[pre]) then
			local src = self.particles[pre].position
			local dst = self.particles[idx].position
			local dir = vector():sub(dst,src):normalize()
			local tmp = src:distance_to(dst)
			ray:set_position(src)
			ray:set_direction(dir)
			ray:set_range(tmp)
			if (ray:query()) then
				self.indicator:Update(vector():mad(src,dir,ray:get_distance() - 0.5))
				self.indicator_idx = idx
			end
		end
		
		pre = idx
	end
	-- Update.
	for idx=self.index_min,self.index_max do
		if (self.indicator_idx == nil) or (idx < self.indicator_idx) then
			self.particles[idx]:Show(true)
		else
			self.particles[idx]:Show(false)
		end
	end
	self.indicator:Show(self.indicator_idx and true or false)
end

function CGrenadeTrajectory:IsModeShow(wpn)
	if (TRAJECTORY_MODE == 0) then
		return false
	end
	if (TRAJECTORY_MODE == 1) then
		return true
	end
	if (TRAJECTORY_MODE == 2) then
		if (self.st.is_grenade ~= true) then
			return true
		end
		if (self:GrenadeIsAiming(wpn)) then
			return true
		end
	end
	return false
end

function CGrenadeTrajectory:Hide()
	for idx=self.index_min,self.index_max do
		self.particles[idx]:Show(false)
	end
	self.indicator:Show(false)
end

function CGrenadeTrajectory:Close()
	self:Hide()
	hud_remove()
end

--[[----------------------------------------------------------------------------------------------------
	Misc
------------------------------------------------------------------------------------------------------]]
function CGrenadeTrajectory:TrajectoryPosition(pos,vel,duration)
	--[[
	x = (v.x * t)
	y = (v.y * t) - (g * (t^2) / 2)
	Assume:
		- Stalker engine has no air resistance. (Confirmed)
		- Object mass doesn't affect the equalization. (Not Confirmed)
	--]]
	local motion = vector():set(vel.x,0,vel.z):mul(duration)
	motion.y = (vel.y * duration) - (level.physics_world():gravity() * math.pow(duration,2) / 2)
	return vector():set(pos):add(motion)
end

function CGrenadeTrajectory:WeaponValidate(wpn)
	if not (wpn) then
		return false
	end
	if (TRAJECTORY_GRD and WeaponGrenade(wpn)) then
		return true
	end
	if (TRAJECTORY_LCH and (WeaponLauncher(wpn) or (wpn:weapon_in_grenade_mode()))) then
		return true
	end
	return false
end

function CGrenadeTrajectory:WeaponLoadData(wpn)
	local sec = wpn:section()
	
	self.st = {}
	self.st.oid = wpn:id()
	self.st.is_grenade = WeaponGrenade(wpn)
	self.st.init_time = time_global() + 500
	
	if (self.st.is_grenade == false) then
		local hud_sec = SYS_GetParam(0,sec,"hud","nil")
		self.st.fire_bone_1 = SYS_GetParam(0,hud_sec,"fire_bone","")
		self.st.fire_bone_2 = SYS_GetParam(0,hud_sec,"fire_bone2","")
	end
end

function CGrenadeTrajectory:GetWeaponBoneId(wpn)
	do
		local bid = wpn:bone_id(self.st.fire_bone_2,true)
		if (bid ~= 65535) then
			return bid
		end
	end
	do
		local bid = wpn:bone_id(self.st.fire_bone_1,true)
		if (bid ~= 65535) then
			return bid
		end
	end
	do
		--Last resort. Should never happen.
		local bid = wpn:bone_id("wpn_body",true)
		if (bid ~= 65535) then
			return bid
		end
	end
end

function CGrenadeTrajectory:GrenadeIsAiming(wpn)
	if (wpn:get_state() == CMissile.eThrowStart or wpn:get_state() == CMissile.eReady) then
		return true
	end
	return false
end

function CGrenadeTrajectory:GrenadeUseDynamicForce(wpn)
	if (wpn:cast_Missile():IsConstPower()) then
		return false
	end
	if not (self:GrenadeIsAiming(wpn)) then
		return false
	end
	return true
end

function CGrenadeTrajectory:GrenadeAiming(wpn)
	return true
end

function CGrenadeTrajectory:GetFirePosition(wpn)
	if (self.st.is_grenade) then
		return db.actor:g_fireParams().pos
	end
	-- Launcher.
	local bid = self:GetWeaponBoneId(wpn)
	return bid and wpn:bone_position(bid,true)
end

function CGrenadeTrajectory:GetFireVelocity(wpn)
	local dir = nil
	local vel = nil
	
	if (self.st.is_grenade) then
		dir = db.actor:g_fireParams().dir
		if (self:GrenadeUseDynamicForce(wpn)) then
			vel = wpn:cast_Missile():GetThrowForce()
		else
			vel = wpn:cast_Missile():GetConstForce()
		end
	else
		local bid = self:GetWeaponBoneId(wpn)
		local rot = bid and wpn:bone_direction(bid,true)
		if (rot) then
			dir = vector():set(0,0,1)
			matrix():setHPB(rot.x,rot.y,rot.z):transform_dir(dir)
		end
		vel = get_launch_speed(wpn)
	end
	
	if (vector_valid(dir) and vel) then
		return vector():set(dir):mul(vel)
	end
end

--[[----------------------------------------------------------------------------------------------------
	Callbacks
------------------------------------------------------------------------------------------------------]]
function actor_on_changed_slot(new_slot,new_obj,pre_slot,pre_obj)
	if (new_obj) and (WeaponGrenade(new_obj) or WeaponLauncher(new_obj)) then
		hud_active()
	end
end

function on_show_hide()
	hud_update()
end

function actor_on_net_destroy()
	hud_remove()
end

--[[----------------------------------------------------------------------------------------------------
	Registers
------------------------------------------------------------------------------------------------------]]
function on_game_start()
	RegisterScriptCallback("GUI_on_show",on_show_hide)
	RegisterScriptCallback("GUI_on_hide",on_show_hide)
	RegisterScriptCallback("actor_on_changed_slot",actor_on_changed_slot)
	RegisterScriptCallback("actor_on_net_destroy",actor_on_net_destroy)
end